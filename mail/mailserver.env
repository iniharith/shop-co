# ── docker-mailserver environment ─────────────────────────────────────────
# Reference: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/

# Hostname users see in the helo / email headers
OVERRIDE_HOSTNAME=mail.kampungcetak.com

# Catch-all / postmaster
POSTMASTER_ADDRESS=postmaster@kampungcetak.com

# TLS — uses Let's Encrypt certs mounted from the host (/etc/letsencrypt)
SSL_TYPE=letsencrypt
# If you self-sign or use a different cert provider, use instead:
#SSL_TYPE=manual
#SSL_CERT_PATH=/etc/letsencrypt/live/mail.kampungcetak.com/fullchain.pem
#SSL_KEY_PATH=/etc/letsencrypt/live/mail.kampungcetak.com/privkey.pem

# ── Features ──────────────────────────────────────────────────────────────
# Prevent users from spoofing each other / other domains
SPOOF_PROTECTION=1
# DKIM signing (keys generated on first run under config/opendkim/)
ENABLE_OPEN_DKIM=1
# Optional: DNSBL / greylisting
ENABLE_POSTGREY=0
# Spam + malware protection (clamav is memory-hungry, disable on small VPS)
ENABLE_SPAMASSASSIN=1
ENABLE_CLAMAV=0
ENABLE_AMAVIS=1
ENABLE_FAIL2BAN=1

# ── Accounts / quotas ─────────────────────────────────────────────────────
ENABLE_QUOTAS=1
# Allow users to manage their own filters
ENABLE_MANAGESIEVE=1
# Deliver + store mail in the single mounted volume (keep to 1)
ONE_DIR=1
# Clean up old temp files / maildir sync
ENABLE_SPAMASSASSIN_KAM=0

# ── Misc ──────────────────────────────────────────────────────────────────
# Report an update available (no action required)
ENABLE_UPDATE_CHECK=1
# Auto-create the mail state dirs
DMS_DEBUG=0
# Restrict the container from using a swap / tmpfs where possible
PERMIT_DOCKER=connected-networks
# Reject mail from misconfigured senders
REJECT_UNLISTED_SENDER=1
