# Admin application
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Sentry runtime configuration (NEXT_PUBLIC_* values are embedded at build time)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=git-commit-sha
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# Sentry source-map upload (build-time secret/configuration)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=git-commit-sha
