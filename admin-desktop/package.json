{
  "name": "kampungcetak-admin",
  "version": "1.0.0",
  "description": "Desktop application for Kampungcetak Admin",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node build-icon.js",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.kampungcetak.admin",
    "productName": "Kampungcetak Admin",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    }
  },
  "author": "Kampungcetak",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^25.0.5",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.4"
  }
}
